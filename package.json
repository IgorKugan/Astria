{
  "name": "astria",
  "productName": "Astria",
  "version": "1.5.0",
  "description": "Navegador desktop com várias sessões independentes para sites e jogos idle.",
  "main": "src/main.js",
  "private": true,
  "author": "Astria",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "package:win": "electron-builder --win nsis",
    "package:portable": "electron-builder --win dir && node scripts/create-portable.js",
    "test": "node tests/smoke.js && node tests/shared-assets.js && node tests/updates.js && node scripts/check-public.js",
    "release:prepare": "node scripts/release.js",
    "test:e2e": "node tests/e2e.js",
    "test:portable": "node tests/portable.js",
    "test:shared": "node tests/shared-e2e.js"
    ,"test:update": "node tests/update-flow.js"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "dependencies": { "yauzl": "3.4.0" },
  "overrides": { "global-agent": "4.1.3" },
  "build": {
    "appId": "com.multinest.desktop",
    "productName": "Astria",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/astria.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Astria-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
