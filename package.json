{
  "name": "astria",
  "productName": "Astria",
  "version": "1.9.0",
  "description": "Portable multi-account browser for browser games, with isolated sessions and a compact interface.",
  "main": "src/main.js",
  "private": true,
  "author": "Astria",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "package:win": "electron-builder --win nsis",
    "package:portable": "electron-builder --win dir && node scripts/create-portable.js",
    "test": "node tests/smoke.js && node tests/view-loads.js && node tests/frame-limiter.js && node tests/performance.js && node tests/floating.js && node tests/memory-cleanup.js && node tests/trusted-ui.js && node tests/i18n.js && node tests/updates.js && node tests/helper-lifecycle.js && node scripts/check-public.js",
    "release:prepare": "node scripts/release.js",
    "test:e2e": "node tests/e2e.js",
    "test:portable": "node tests/portable.js",
    "test:network": "node tests/network-e2e.js",
    "test:performance": "node tests/performance-e2e.js",
    "test:activity": "node tests/activity-e2e.js",
    "test:startup": "node tests/startup-e2e.js",
    "test:browser": "node tests/browser-behavior-e2e.js",
    "test:close": "node tests/close-e2e.js",
    "test:update": "node tests/update-flow.js",
    "test:floating": "node tests/floating-e2e.js && node tests/floating-multi-e2e.js",
    "test:layers": "node tests/layering-e2e.js",
    "brand:build": "node scripts/create-brand.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.multinest.desktop",
    "productName": "Astria",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/astria.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Astria-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
